# Frontend
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Server-side Gemini (used by the Node server for message analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_string
WHATSAPP_ACCESS_TOKEN=replace_with_your_system_user_or_temporary_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_your_waba_id
WHATSAPP_GRAPH_VERSION=v23.0
PORT=3001

# Hindsight Persistent Memory (https://hindsight.vectorize.io/)
# Self-hosted:  HINDSIGHT_BASE_URL=http://localhost:8888
# Cloud:        HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=
# Required for Hindsight Cloud (not needed for self-hosted with no auth)
HINDSIGHT_API_KEY=
